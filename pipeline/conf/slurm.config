// slurm executor profile.
// override queue/account via `-c custom.config` or env-specific overrides.

process {
    executor = 'slurm'
    // queue = 'your_queue'     // set for your cluster
    // clusterOptions = '--account=your_account'
}

executor {
    name            = 'slurm'
    queueSize       = 100
    submitRateLimit = '10/1min'
}
