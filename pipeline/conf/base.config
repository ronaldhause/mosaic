// default resource labels — applied to all profiles unless overridden.

process {
    errorStrategy = 'retry'
    maxRetries    = 1

    withLabel: process_low {
        cpus   = 1
        memory = 4.GB
        time   = 1.h
    }

    withLabel: process_medium {
        cpus   = 4
        memory = 16.GB
        time   = 8.h
    }
}
